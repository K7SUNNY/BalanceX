<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAppLockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="48dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgLockIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="Vault lock shield"
            app:srcCompat="@drawable/ic_shield_check"
            app:tint="@color/action_security_tint" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="BalanceX Locked"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Authentication is required to access your financial data, accounts, and reports."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textLockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/finance_expense"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlockApp"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/action_security_tint"
        android:elevation="4dp"
        android:letterSpacing="0.02"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        android:text="Unlock BalanceX"
        android:textColor="@color/color_on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_shield_check"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="20dp"
        app:iconTint="@color/color_on_primary" />

</LinearLayout>
